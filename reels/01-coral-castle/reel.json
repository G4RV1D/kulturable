    {"image": "img3.jpg", "duration": 3.2, "zoom": "in", "crop": [0.05, 0.06, 0.95, 0.94],
     "text": [{"text": "La nuit. À la lanterne.", "size": 72}, {"text": "Sans grue. Sans ouvriers.", "size": 72, "color": [255, 196, 72]}]},
    {"image": "img4.jpg", "duration": 3.4, "zoom": "out", "pan": 0.4,
